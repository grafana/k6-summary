{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metric.v1.schema.json",
  "title": "k6 Metric Schema v1",
  "description": "JSON schema for k6 metric objects with category information",
  "oneOf": [
    {
      "$ref": "#/$defs/counter"
    },
    {
      "$ref": "#/$defs/gauge"
    },
    {
      "$ref": "#/$defs/rate"
    },
    {
      "$ref": "#/$defs/trend"
    }
  ],
  "$defs": {
    "common": {
      "type": "object",
      "description": "Base properties for all metrics",
      "required": ["name", "type", "contains", "category"],
      "properties": {
        "name": {
          "type": "string",
          "description": "The metric name"
        },
        "type": {
          "type": "string",
          "enum": ["counter", "gauge", "rate", "trend"],
          "description": "The metric type"
        },
        "contains": {
          "type": "string",
          "enum": ["default", "time", "data"],
          "description": "The type of data the metric contains"
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z_]+$",
          "description": "The metric category",
          "examples": ["http", "execution", "network", "browser", "web_vitals", "grpc", "websocket", "custom"],
          "$comment": "The category field is left open to allow for future expansion of the metric categories. It however should contain a valid identifier."
        }
      }
    },
    "counter": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "required": ["values"],
          "additionalProperties": false,
          "properties": {
            "name": true,
            "type": {
              "const": "counter"
            },
            "contains": true,
            "category": true,
            "values": {
              "type": "object",
              "description": "Counter metric values",
              "required": ["count", "rate"],
              "additionalProperties": false,
              "properties": {
                "count": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Total count of events"
                },
                "rate": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Rate of events per second"
                }
              }
            }
          }
        }
      ]
    },
    "gauge": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "required": ["values"],
          "additionalProperties": false,
          "properties": {
            "name": true,
            "type": {
              "const": "gauge"
            },
            "contains": true,
            "category": true,
            "values": {
              "type": "object",
              "description": "Gauge metric values",
              "required": ["value", "min", "max"],
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "number",
                  "description": "Current/final gauge value"
                },
                "min": {
                  "type": "number",
                  "description": "Minimum observed value"
                },
                "max": {
                  "type": "number",
                  "description": "Maximum observed value"
                }
              }
            }
          }
        }
      ]
    },
    "rate": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "required": ["values"],
          "additionalProperties": false,
          "properties": {
            "name": true,
            "type": {
              "const": "rate"
            },
            "contains": true,
            "category": true,
            "values": {
              "type": "object",
              "description": "Rate metric values",
              "required": ["rate", "passes", "fails"],
              "additionalProperties": false,
              "properties": {
                "rate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Success rate as a decimal (0.0 to 1.0)"
                },
                "passes": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Number of successful events"
                },
                "fails": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Number of failed events"
                }
              }
            }
          }
        }
      ]
    },
    "trend": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "required": ["values"],
          "additionalProperties": false,
          "properties": {
            "name": true,
            "type": {
              "const": "trend"
            },
            "contains": true,
            "category": true,
            "values": {
              "type": "object",
              "description": "Trend metric values with configurable statistics",
              "required": ["count"],
              "additionalProperties": false,
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Number of data points"
                },
                "avg": {
                  "type": "number",
                  "description": "Average (mean) value"
                },
                "min": {
                  "type": "number",
                  "description": "Minimum value"
                },
                "med": {
                  "type": "number",
                  "description": "Median value"
                },
                "max": {
                  "type": "number",
                  "description": "Maximum value"
                },
                "p(90)": {
                  "type": "number",
                  "description": "90th percentile"
                },
                "p(95)": {
                  "type": "number",
                  "description": "95th percentile"
                },
                "p(99)": {
                  "type": "number",
                  "description": "99th percentile"
                },
                "p(99.9)": {
                  "type": "number",
                  "description": "99.9th percentile"
                }
              },
              "patternProperties": {
                "^p\\([0-9]+(\\.[0-9]+)?\\)$": {
                  "type": "number",
                  "description": "Custom percentile value"
                }
              }
            }
          }
        }
      ]
    }
  }
}