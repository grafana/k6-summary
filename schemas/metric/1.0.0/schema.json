{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "k6 Metric Schema v1",
  "description": "JSON schema for k6 metric objects",
  "oneOf": [
    {
      "$ref": "#/$defs/counter"
    },
    {
      "$ref": "#/$defs/gauge"
    },
    {
      "$ref": "#/$defs/rate"
    },
    {
      "$ref": "#/$defs/trend"
    }
  ],
  "$defs": {
    "common": {
      "type": "object",
      "description": "Base properties for all metrics",
      "required": ["name", "type", "contains"],
      "properties": {
        "name": {
          "type": "string",
          "description": "The metric name"
        },
        "type": {
          "type": "string",
          "enum": ["counter", "gauge", "rate", "trend"],
          "description": "The metric type"
        },
        "contains": {
          "type": "string",
          "enum": ["default", "time", "data"],
          "description": "The type of data the metric contains"
        }
      }
    },
    "counter": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "required": ["values"],
          "additionalProperties": false,
          "properties": {
            "name": true,
            "type": {
              "const": "counter"
            },
            "contains": true,
            "values": {
              "type": "object",
              "description": "Counter metric values",
              "required": ["count"],
              "additionalProperties": false,
              "properties": {
                "count": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Total count of events"
                }
              }
            }
          }
        }
      ]
    },
    "gauge": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "required": ["values"],
          "additionalProperties": false,
          "properties": {
            "name": true,
            "type": {
              "const": "gauge"
            },
            "contains": true,
            "values": {
              "type": "object",
              "description": "Gauge metric values",
              "required": ["value", "min", "max"],
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "number",
                  "description": "Current/final gauge value"
                },
                "min": {
                  "type": "number",
                  "description": "Minimum observed value"
                },
                "max": {
                  "type": "number",
                  "description": "Maximum observed value"
                }
              }
            }
          }
        }
      ]
    },
    "rate": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "required": ["values"],
          "additionalProperties": false,
          "properties": {
            "name": true,
            "type": {
              "const": "rate"
            },
            "contains": true,
            "values": {
              "type": "object",
              "description": "Rate metric values",
              "required": ["matches", "total"],
              "additionalProperties": false,
              "properties": {
                "matches": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Number of successful events"
                },
                "total": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Total number of events (matches + fails)"
                }
              }
            }
          }
        }
      ]
    },
    "trend": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "required": ["values"],
          "additionalProperties": false,
          "properties": {
            "name": true,
            "type": {
              "const": "trend"
            },
            "contains": true,
            "values": {
              "type": "object",
              "description": "Trend metric values with configurable statistics",
              "additionalProperties": false,
              "$comment": "Trend metrics' properties can be overridden, we don't require them to be present, and instead list the default ones.",
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Number of data points"
                },
                "avg": {
                  "type": "number",
                  "description": "Average (mean) value"
                },
                "min": {
                  "type": "number",
                  "description": "Minimum value"
                },
                "med": {
                  "type": "number",
                  "description": "Median value"
                },
                "max": {
                  "type": "number",
                  "description": "Maximum value"
                },
                "p(90)": {
                  "type": "number",
                  "description": "90th percentile"
                },
                "p(95)": {
                  "type": "number",
                  "description": "95th percentile"
                }
              },
              "patternProperties": {
                "^p\\([0-9]+(\\.[0-9]+)?\\)$": {
                  "type": "number",
                  "description": "Custom percentile value"
                }
              }
            }
          }
        }
      ]
    }
  }
}
